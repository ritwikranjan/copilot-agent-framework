{
  "name": "@ritwikranjan/copilot-agent-framework",
  "version": "0.1.0",
  "description": "Framework-agnostic wrapper for GitHub Copilot SDK with stateless session management, audit logging, and pluggable persistence — built for horizontal scaling",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "debug": "^4.4.0",
    "uuid": "^11.0.5"
  },
  "peerDependencies": {
    "@github/copilot-sdk": ">=0.1.20"
  },
  "peerDependenciesMeta": {
    "@github/copilot-sdk": {
      "optional": false
    }
  },
  "devDependencies": {
    "@github/copilot-sdk": "^0.1.20",
    "@types/debug": "^4.1.12",
    "@types/node": "^22.10.7",
    "@types/uuid": "^10.0.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "copilot",
    "github-copilot",
    "copilot-sdk",
    "stateless",
    "agent-framework",
    "session-management",
    "horizontal-scaling",
    "mcp",
    "streaming"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ritwikranjan/copilot-agent-framework"
  },
  "homepage": "https://github.com/ritwikranjan/copilot-agent-framework#readme",
  "bugs": {
    "url": "https://github.com/ritwikranjan/copilot-agent-framework/issues"
  },
  "author": "Ritwik Ranjan",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  }
}
