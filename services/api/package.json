{
  "name": "copilot-api-service",
  "version": "1.0.0",
  "description": "Internal API service for Copilot Agent Framework — owns session, audit, and copilot interaction",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup",
    "start": "node dist/index.js",
    "dev": "tsx watch -r dotenv/config src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@azure/cosmos": "^4.2.0",
    "@azure/identity": "^4.5.0",
    "@azure/monitor-opentelemetry": "^1.16.0",
    "@github/copilot-sdk": "^0.1.32",
    "@opentelemetry/api": "^1.9.1",
    "@ritwikranjan/copilot-agent-framework": "*",
    "express": "^4.21.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/uuid": "^10.0.0",
    "dotenv": "^16.4.5",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
