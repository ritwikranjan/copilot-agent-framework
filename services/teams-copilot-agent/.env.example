# Teams Copilot Agent Environment Variables
# Copy this file to .env and fill in the values

# Copilot CLI Server URL (required)
CLI_URL=localhost:3000

# Teams Bot Configuration (required for production)
BOT_ID=
AZURE_CLIENT_ID=

# Model Configuration
MODEL=gpt-4.1
AGENT_NAME=teams-copilot-agent

# Audit Configuration
ENABLE_AUDIT=true
COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
COSMOS_DATABASE_NAME=AuditDB

# Optional: User-Assigned Managed Identity for Cosmos DB
# USER_ASSIGNED_MSI_CLIENT_ID=

# Development Mode
NODE_ENV=development
PORT=3978